[Desktop Entry]
Type=Application
Name=UniCent Host
Comment=UniCent mouse/keyboard sharing — Host
Exec=/usr/local/bin/unicent-host --no-tls --client-side left
Path=/opt/unicent
Icon=/opt/unicent/assets/icon-u-128.png
Terminal=false
Categories=Utility;Network;
StartupNotify=false
X-GNOME-Autostart-enabled=true
